NODE_ENV=production
HOST=127.0.0.1
PORT=8112

# Generate independently: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-characters
EXECUTOR_TOKEN=replace-with-another-at-least-32-character-token

ALLOWED_HOST_SUFFIXES=sudrf.ru
ALLOWED_PROTOCOLS=https
ALLOWED_METHODS=GET
DEFAULT_TIMEOUT_MS=30000
MIN_TIMEOUT_MS=1000
MAX_TIMEOUT_MS=30000
MAX_RESPONSE_BYTES=1048576
MAX_INFLIGHT_PER_EXECUTOR=16
MAX_QUEUE_SIZE=500
QUEUE_WAIT_MS=10000
API_RATE_LIMIT_PER_MINUTE=600
TRUST_PROXY_HOPS=1
DEFAULT_ENCODING=win1251
