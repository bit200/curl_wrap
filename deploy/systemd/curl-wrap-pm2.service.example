[Unit]
Description=curl-wrap PM2 process manager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=curl-wrap
Group=curl-wrap
Environment=PATH=/opt/node-v24.19.0-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PM2_HOME=/var/lib/curl-wrap-pm2
Environment=CURL_WRAP_NODE=/opt/node-v24.19.0-linux-x64/bin/node
LimitNOFILE=65536
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
ExecStart=/opt/curl-wrap-pm2/bin/pm2 start /opt/curl-wrap/current/ecosystem.config.cjs --no-daemon
ExecReload=/opt/curl-wrap-pm2/bin/pm2 reload /opt/curl-wrap/current/ecosystem.config.cjs --update-env

[Install]
WantedBy=multi-user.target
